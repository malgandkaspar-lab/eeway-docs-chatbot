# Option A: Anthropic Claude (hosted, needs a key + internet)
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Option B: local model via Ollama (https://ollama.com) - free, offline,
# no API key. Requires Ollama running locally with a model pulled, e.g.:
#   ollama pull qwen3:8b
# Uncomment to force local mode (otherwise Claude is used automatically
# whenever ANTHROPIC_API_KEY is set above):
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=qwen3:8b
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_THINK=false

# Search always runs locally regardless of the LLM backend above.
# Requires: ollama pull nomic-embed-text
# OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional overrides
# PORT=3000
# CLAUDE_MODEL=claude-haiku-4-5-20251001
